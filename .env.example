# Database
DATABASE_URI=postgresql://plu_user:plu_password@localhost:5433/plu_analyzer

# Payload CMS
PAYLOAD_SECRET=replace-with-a-strong-32-char-secret-key
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# External Urban-Planning APIs
GEOCODING_API_URL=https://data.geopf.fr/geocodage/search
IGN_APICARTO_BASE_URL=https://apicarto.ign.fr/api
GPU_API_BASE_URL=https://www.geoportail-urbanisme.gouv.fr/api
AMP_ARCGIS_PLUI_URL=https://sig.ampmetropole.fr/arcgis/rest/services
AMP_ARCGIS_ZONING_LAYER=PLUi/MapServer/0

# AI Interpretation (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional OCR Command (e.g. tesseract)
OCR_ENABLED=false
OCR_COMMAND=tesseract
